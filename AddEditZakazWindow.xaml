<Window x:Class="ShoeStore_Бихе.AddEditZakazWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Бихе"
        mc:Ignorable="d"
        Title="AddEditZakazWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Артикул заказа:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Name="TBCode" Grid.Row="0" Grid.Column="1" Margin="0,5"/>

        <TextBlock Text="Статус заказа:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox Name="CBStatus" Grid.Row="1" Grid.Column="1" Margin="0,5"/>

        <TextBlock Text="Адрес пункта выдачи:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <ComboBox Name="CBAddress" Grid.Row="2" Grid.Column="1" Margin="0,5"/>

        <TextBlock Text="Дата заказа:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Name="TBOrderDate" Grid.Row="3" Grid.Column="1" Margin="0,5"/>

        <TextBlock Text="Дата доставки:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox Name="TBDeliveryDate" Grid.Row="4" Grid.Column="1" Margin="0,5"/>

        <TextBlock Text="Состав заказа" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
        <TextBox x:Name="TBSostav" Grid.Row="5" Grid.Column="1"/>

        <Button Name="BtnSave" Grid.Row="6" Grid.Column="1" Content="Сохранить" 
                Width="120" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                Margin="5" Click="BtnSave_Click"/>
    </Grid>
</Window>
