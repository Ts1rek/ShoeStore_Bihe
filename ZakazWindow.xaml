<Window x:Class="ShoeStore_Бихе.ZakazWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Бихе"
        mc:Ignorable="d"
        Title="Заказы" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Список заказов" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <ListView Name="ListZakaz" Grid.Row="1" 
                  MouseDoubleClick="ListOrders_MouseDoubleClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>

                    <Border BorderThickness="2" Margin="5" BorderBrush="Black" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Артикул заказа: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Code}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Статус заказа: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Status.Status1}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Адрес пункта выдачи: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Adress_Pynkta_vidachi.Adress_Pynkta_vidachi1}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Дата заказа: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Date_zakaz, StringFormat=d}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" BorderThickness="2" BorderBrush="Black" 
                                    Padding="15" MinWidth="150" VerticalAlignment="Stretch">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Дата доставки" TextAlignment="Center" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Date_dostavca, StringFormat=d}" 
                                               TextAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="BtnAdd" Content="Добавить заказ" Width="150" Height="30" Margin="5" Click="BtnAdd_Click"/>
            <Button Name="BtnEdit" Content="Редактировать" Width="150" Height="30" Margin="5" Click="BtnEdit_Click"/>
            <Button Name="BtnDelete" Content="Удалить" Width="150" Height="30" Margin="5" Click="BtnDelete_Click"/>
        </StackPanel>
    </Grid>
</Window>
