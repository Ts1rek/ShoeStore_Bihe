<Window x:Class="ShoeStore_Бихе.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Бихе"
        mc:Ignorable="d"
        Title="ООО Обувь - Список товаров"
        Height="450" Width="840">

        <Window.Resources>
            <local:ImagePathConverter x:Key="ImgConv"/>
        </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>
        <ListView Name="ListTovar" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="8" MouseDoubleClick="ListTovar_MouseDoubleClick">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding is_discount}" Value="True">
                            <Setter Property="Background" Value="#2E8B57"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding is_quantity}" Value="True">
                            <Setter Property="Background" Value="Cyan"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" Margin="5" BorderBrush="Black">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="400"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderThickness="2" Margin="5" BorderBrush="Black">
                                <Image Source="{Binding Picture, Converter={StaticResource ImgConv}}" Margin="10" Width="120"/>
                            </Border>

                            <Border Grid.Column="1" BorderThickness="1" BorderBrush="Black" Margin="5">
                                <StackPanel Margin="5" Orientation="Vertical">

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Kategory.Kategory1}" FontWeight="Bold"/>
                                        <TextBlock Text=" | " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding TovarName}" FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Описание товара: "/>
                                        <TextBlock Text="{Binding OpisTovar}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Производитель: "/>
                                        <TextBlock Text="{Binding Proizvod.Proizvod1}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Поставщик: "/>
                                        <TextBlock Text="{Binding Postavshik.Postavshik1}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Цена: "/>
                                        <TextBlock Text="{Binding Price}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding is_on_sale}" Value="True">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="5,0,0,0"
                                                   Text="{Binding price_discount, StringFormat=Новая цена: {0} руб.}"
                                                   FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Единица измерения: "/>
                                        <TextBlock Text="{Binding EdinichIzmeren}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Количество на складе: "/>
                                        <TextBlock Text="{Binding CountSklade}"/>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" BorderThickness="3" Margin="5" BorderBrush="Black">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Действующая" TextAlignment="Center"/>
                                    <TextBlock Text="скидка" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding Skidka, StringFormat={}{0}%}"
                                               FontWeight="Bold"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Border>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="8" Background="LimeGreen"/>
        <Image Source="C:\Всё\4 курс\Рпитм 4 курс\ShoeStore_Бихе\Picture\Icon.png" Grid.Column="3" Grid.Row="0"/>
        <TextBlock Text="ФИО" Grid.Column="6" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Name="TBlockFio"/>
        <Button x:Name="BtnExit" Content="Выйти из системы" Margin="10" Grid.Column="0" Grid.Row="0" Click="BtnExit_Click"/>
        <TextBlock Text="ООО Обувь" Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="0" FontSize="22" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Name="SPTX" Panel.ZIndex="1">
            <TextBlock Text="Сортировка (по количеству на складе)" VerticalAlignment="Top" Margin="20,0,0,10" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="8" Orientation="Horizontal" x:Name="SPPanel" Panel.ZIndex="0" Background="LimeGreen">
        <TextBlock Text="Поиск" VerticalAlignment="Center" FontSize="15" Margin="5"/>
        <TextBox x:Name="TbSearch" TextChanged="TbSearch_TextChanged" Width="75" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        <Button x:Name="BtnUp" Content="По возрастанию" VerticalAlignment="Center" Margin="10" Click="BtnUp_Click"/>
        <Button x:Name="BtnDown" Content="По убыванию" VerticalAlignment="Center" Margin="10" Click="BtnDown_Click"/>
        <TextBlock Text="Поставщик" VerticalAlignment="Center" FontSize="13" Margin="5"/>
        <ComboBox SelectionChanged="CBPostav_SelectionChanged" VerticalAlignment="Center"  Name="CBPostav" HorizontalAlignment="Right" Width="100" Margin="5"/>
        <Button x:Name="BtnSbrosfiltr" Content="Сбросить фильтры" VerticalAlignment="Center" Margin="5" Click="BtnSbrosfiltr_Click"/>
            <Button x:Name="BtnAddtovar" Content="Добавить товар" VerticalAlignment="Center" HorizontalAlignment="Center" Width="55" Click="BtnAddtovar_Click"/>
            <Button x:Name="BtnDel" Content="Удалить товар" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5" Click="BtnDel_Click"/>
            <Button x:Name="Btnzakaz" Content="Заказы" VerticalAlignment="Center" Click="Btnzakaz_Click"/>
        </StackPanel>
    </Grid>
</Window>