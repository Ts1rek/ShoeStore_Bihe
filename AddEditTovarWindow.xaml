<Window x:Class="ShoeStore_Бихе.AddEditTovarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore_Бихе"
        mc:Ignorable="d"
        Title="AddEditTovarWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="2*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>

        </Grid.RowDefinitions>
        <StackPanel Orientation="Vertical" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="LawnGreen"/>
        <TextBlock Text="Управление товаром" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="25"/>
        <Button x:Name="BtnFoto" Content="Выбрать фото" Grid.Column="1" Grid.Row="1" VerticalAlignment="Top" Click="BtnFoto_Click" Margin="0,15,0,0"/>
        <TextBlock x:Name="TBImage" Text="Наименование изображения" Grid.Column="1" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBlock Text="Фото товара" Grid.Column="0" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Image x:Name="ImgTov" Source="/Picture/Icon.png" Grid.Column="0" Grid.Row="1" Width="125" HorizontalAlignment="Right" Margin="0,0,20,0"/>
        <TextBlock Text="Наименование товара" Grid.Column="0" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Text="Категория товара" Grid.Column="0" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Text="Описание товара" Grid.Column="0" Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Text="производитель товара" Grid.Column="0" Grid.Row="5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Text="Поставщик товара" Grid.Column="0" Grid.Row="6" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Text="Цена товара" Grid.Column="0" Grid.Row="7" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Text="Единица измерения товара" Grid.Column="0" Grid.Row="8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Text="Количество товара на складе" Grid.Column="0" Grid.Row="9" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBlock Text="Действующая скидка" Grid.Column="0" Grid.Row="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBox x:Name="TBNameTov" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"/>
        <ComboBox Name="CBKatTov" Grid.Column="1" Grid.Row="3" VerticalAlignment="Center"/>
        <TextBox x:Name="TBOpisTov" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center"/>
        <ComboBox Name="CBProizvod" Grid.Column="1" Grid.Row="5" VerticalAlignment="Center"/>
        <ComboBox Name="CBPostavshik" Grid.Column="1" Grid.Row="6" VerticalAlignment="Center"/>
        <TextBox x:Name="TBPrice" Grid.Row="7" Grid.Column="1" VerticalAlignment="Center"/>
        <TextBox x:Name="TBEdIzm" Grid.Row="8" Grid.Column="1" VerticalAlignment="Center"/>
        <TextBox x:Name="TBColnasklade" Grid.Row="9" Grid.Column="1" VerticalAlignment="Center"/>
        <TextBox x:Name="TBSkidka" Grid.Row="10" Grid.Column="1" VerticalAlignment="Center"/>
        <Button x:Name="BtnSave" Content="Сохранить данные" Grid.Column="0" Grid.Row="11" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Click="BtnSave_Click"/>
    </Grid>
</Window>
